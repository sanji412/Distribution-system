<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buu.order.mapper.OrderItemMapper">

    <select id="selectFirstByOrderId" resultType="com.buu.order.entity.OrderItem">
        SELECT
            item_id,
            order_id,
            product_id,
            product_name,
            product_price,
            quantity,
            sub_total,
            create_time
        FROM order_item
        WHERE order_id = #{orderId}
        ORDER BY item_id ASC
        LIMIT 1
    </select>
</mapper>
