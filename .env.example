# Copy this file to .env before running Docker Compose.

MYSQL_ROOT_PASSWORD=distribution_root_123
JWT_SECRET=distribution-platform-change-me-to-a-long-random-secret

# Host ports. Keep defaults for classroom demo, change them if another local service already uses a port.
FRONTEND_HOST_PORT=5173
GATEWAY_HOST_PORT=9000
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
NACOS_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848
SEATA_CONSOLE_HOST_PORT=7091
SEATA_HOST_PORT=8091
USER_SERVICE_HOST_PORT=8001
PRODUCT_SERVICE_HOST_PORT=8002
STOCK_SERVICE_HOST_PORT=8003
ORDER_SERVICE_HOST_PORT=8005
PAY_SERVICE_HOST_PORT=8006
AUTH_SERVICE_HOST_PORT=8007

# Fill this with your real DeepSeek key for online AI answers.
# If left as sk-placeholder, AI chat and recommendation endpoints will use local fallback.
DEEPSEEK_API_KEY=sk-placeholder
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
